# SampleDB deployment configuration
# Copy to .env and adjust. docker-compose reads .env automatically.

# --- Docker / bind mount ---

# Host path for the database (bind mount). Default: ./data
# Set to e.g. /var/lib/sampledb to store data elsewhere.
# HOST_DATA_DIR=./data

# Host port to expose. Default: 3000
# Use when 3000 is already in use: PORT=8080
# PORT=3000

# --- Application ---

# Path to SQLite file inside the container. Default: /data/sampledb.sqlite
# Override only if you use a different mount path in the volume.
# DATABASE_PATH=/data/sampledb.sqlite

# Comma-separated CORS origins for production.
# REQUIRED in production—if unset, CORS rejects all cross-origin requests.
# Set to your app URL, e.g. https://sampledb.example.com
ALLOWED_ORIGINS=http://localhost:3000

# --- Error logging (optional) ---

# Enable error logging to database. Default: true
# ERROR_LOG_ENABLED=true

# Minimum level to log: info, warning, error. Default: error
# ERROR_LOG_LEVEL=error

# Days to retain error logs before cleanup. Unset = use default (e.g. 90)
# ERROR_LOG_RETENTION_DAYS=90

# Expose OpenAPI docs at /api/docs in production. Default: false (disabled in prod)
# OPENAPI_ENABLED=true
