{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "types": [
            "node",
            "@playwright/test"
        ]
    },
    "include": [
        "src/**/*",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}