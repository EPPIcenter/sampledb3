# Copy to backup.env on the backup host — do not commit secrets.
# From repo root: set -a && source ops/backup/backup.env && set +a

# Path to the SQLite file on the machine that runs the backup.
# Docker bind mount: host path, e.g. /var/lib/sampledb/sampledb.sqlite
DATABASE_PATH=/var/lib/sampledb/sampledb.sqlite

# restic repository (encrypted)
# RESTIC_REPOSITORY=local:/backup/restic-sampledb
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket/sampledb
RESTIC_REPOSITORY=

RESTIC_PASSWORD=

# RESTIC_TAG=sampledb
# BACKUP_STDIN_FILENAME=sampledb.sqlite

# S3-style credentials when using s3: repository
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

RUN_RESTIC_FORGET=0

# Optional: restic cache dir (useful if the default cache location is not writable)
# RESTIC_CACHE=/var/cache/restic
