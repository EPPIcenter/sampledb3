{
  "name": "sampledb",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratory Information Management System for sample tracking, experiment management, and SRA submissions",
  "scripts": {
    "dev": "bun --filter '*' --parallel dev",
    "dev:api": "bun --filter @sampledb/api dev",
    "dev:api:production": "bun --filter @sampledb/api dev:production",
    "dev:web": "bun --filter @sampledb/web dev",
    "dev:production": "bun --filter @sampledb/api dev:production & bun --filter @sampledb/web dev",
    "build": "bun --filter '*' build",
    "build:api": "bun --filter @sampledb/api build",
    "build:web": "bun --filter @sampledb/web build",
    "start": "bun --filter @sampledb/api start",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck"
  },
  "keywords": [
    "lims",
    "laboratory",
    "sample-management",
    "malaria",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {}
}