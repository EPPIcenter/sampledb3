{
  "name": "sampledb",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratory Information Management System for sample tracking, experiment management, and SRA submissions",
  "scripts": {
    "dev": "bun --filter '*' --parallel dev",
    "dev:api": "bun --filter @sampledb/api dev",
    "dev:web": "bun --filter @sampledb/web dev",
    "dev:docs": "bun --filter @sampledb/docs dev",
    "build": "bun --filter '*' build",
    "build:api": "bun --filter @sampledb/api build",
    "build:web": "bun --filter @sampledb/web build",
    "build:docs": "bun --filter @sampledb/docs build",
    "start": "bun --filter @sampledb/api start",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun run --filter @sampledb/api test && bun run --filter @sampledb/web test",
    "test:coverage": "bun run --filter @sampledb/api test:coverage && bun run --filter @sampledb/web test:coverage",
    "test:e2e": "bun --filter @sampledb/e2e test",
    "demo:seed": "bun --filter @sampledb/api demo:seed"
  },
  "keywords": [
    "lims",
    "laboratory",
    "sample-management",
    "malaria",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "workspaces": [
    "packages/api",
    "packages/web",
    "packages/docs",
    "packages/e2e"
  ],
  "dependencies": {}
}
