{
  "name": "sampledb",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratory Information Management System for sample tracking, experiment management, and SRA submissions",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @sampledb/api dev",
    "dev:web": "pnpm --filter @sampledb/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @sampledb/api build",
    "build:web": "pnpm --filter @sampledb/web build",
    "start": "pnpm --filter @sampledb/api start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": ["lims", "laboratory", "sample-management", "malaria", "research"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
